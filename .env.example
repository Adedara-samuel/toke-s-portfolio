# Contact form (Nodemailer). Copy to .env.local and fill in.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=oluwatosinfavour17@gmail.com
SMTP_PASS=your-16-character-app-password

# Optional. Where enquiries are delivered (defaults to the email on the CV)
# and the sender address (defaults to SMTP_USER).
CONTACT_TO_EMAIL=oluwatosinfavour17@gmail.com
SMTP_FROM=
