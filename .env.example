# Contact form (Nodemailer). Copy this file to .env.local and fill it in.
#
# SENDER: any Gmail account can send the mail, e.g. a separate account made just
# for the website. It does NOT have to be the CV email.
#   1. Sign in to the sending account and turn on 2-Step Verification.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Put that account's address in SMTP_USER and the 16-character app password in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sending-account@gmail.com
SMTP_PASS=your-16-character-app-password

# RECEIVER: every message from the contact form is delivered here.
# If left empty it still defaults to the CV email below.
CONTACT_TO_EMAIL=oluwatosinfavour17@gmail.com

# Optional "From" address. Leave empty to use SMTP_USER (recommended for Gmail).
SMTP_FROM=
